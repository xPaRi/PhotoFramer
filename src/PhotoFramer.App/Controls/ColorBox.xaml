<UserControl x:Class="PhotoFramer.App.Controls.ColorBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:PhotoFramer.App.Controls"
             x:Name="Root">
    <UserControl.Resources>
        <!-- Posuvník s vlastní šablonou: značka i vyplněná část mají barvu kanálu (Foreground) -->
        <Style x:Key="ChannelRepeatButton" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" Height="22">
                            <Border Background="{TemplateBinding Background}" Height="4" CornerRadius="2" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ChannelThumb" TargetType="Thumb">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Ellipse Fill="{TemplateBinding Foreground}" Stroke="White" StrokeThickness="2" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ChannelSlider" TargetType="Slider">
            <Setter Property="Maximum" Value="255" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent">
                            <Border Height="4" CornerRadius="2" Background="#55888888" VerticalAlignment="Center" />
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ChannelRepeatButton}" Command="Slider.DecreaseLarge"
                                                  Background="{TemplateBinding Foreground}" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ChannelRepeatButton}" Command="Slider.IncreaseLarge" Background="Transparent" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ChannelThumb}" Foreground="{TemplateBinding Foreground}" />
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <StackPanel Orientation="Horizontal">
        <TextBox x:Name="HexBox" c:InputFilter.Mode="Hex" MaxLength="7" Width="125" Height="24" MinHeight="24" Padding="6,2" VerticalContentAlignment="Center"
                 ToolTip="Barva ve tvaru #RRGGBB"
                 Text="{Binding Hex, ElementName=Root, UpdateSourceTrigger=PropertyChanged}" />
        <Border x:Name="Swatch" Width="24" Height="24" Margin="6,0,0,0" BorderBrush="Gray" BorderThickness="1" CornerRadius="2"
                Cursor="Hand" ToolTip="Vybrat barvu" MouseLeftButtonUp="Swatch_Click" />
        <Popup x:Name="Popup" PlacementTarget="{Binding ElementName=Swatch}" StaysOpen="False">
            <Border x:Name="PopupBorder" Background="White" BorderBrush="Gray" BorderThickness="1" Padding="8">
                <StackPanel Width="200">
                    <DockPanel><TextBlock Text="R" Width="16" VerticalAlignment="Center" /><Slider x:Name="SliderR" Style="{StaticResource ChannelSlider}" Foreground="#E53935" ValueChanged="Slider_ValueChanged" /></DockPanel>
                    <DockPanel><TextBlock Text="G" Width="16" VerticalAlignment="Center" /><Slider x:Name="SliderG" Style="{StaticResource ChannelSlider}" Foreground="#43A047" ValueChanged="Slider_ValueChanged" /></DockPanel>
                    <DockPanel><TextBlock Text="B" Width="16" VerticalAlignment="Center" /><Slider x:Name="SliderB" Style="{StaticResource ChannelSlider}" Foreground="#1E88E5" ValueChanged="Slider_ValueChanged" /></DockPanel>
                    <ItemsControl x:Name="Presets" Margin="0,6,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="20" Height="20" Margin="2" BorderBrush="Gray" BorderThickness="1" Cursor="Hand"
                                        Background="{Binding}" Tag="{Binding}" MouseLeftButtonUp="Preset_Click" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Popup>
    </StackPanel>
</UserControl>
