<UserControl x:Class="PhotoFramer.App.Controls.CropView" Focusable="True" FocusVisualStyle="{x:Null}"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <TextBlock x:Name="Info" DockPanel.Dock="Bottom" Foreground="#FFBBBBBB" Margin="0,6,0,0" />
        <Grid x:Name="Host" SizeChanged="Host_SizeChanged">
            <Canvas x:Name="Surface" HorizontalAlignment="Center" VerticalAlignment="Center" Background="Black"
                    MouseLeftButtonDown="Surface_MouseDown" MouseMove="Surface_MouseMove"
                    MouseLeftButtonUp="Surface_MouseUp" MouseRightButtonUp="Surface_RightClick" MouseWheel="Surface_MouseWheel">
                <Image x:Name="Photo" Stretch="Fill" IsHitTestVisible="False" />
                <Path x:Name="Dim" Fill="#99000000" IsHitTestVisible="False" />
                <Rectangle x:Name="Frame" Stroke="White" StrokeThickness="1.5" IsHitTestVisible="False" />
                <Rectangle x:Name="HandleTl" Width="12" Height="12" Fill="White" Stroke="Black" IsHitTestVisible="False" />
                <Rectangle x:Name="HandleTr" Width="12" Height="12" Fill="White" Stroke="Black" IsHitTestVisible="False" />
                <Rectangle x:Name="HandleBl" Width="12" Height="12" Fill="White" Stroke="Black" IsHitTestVisible="False" />
                <Rectangle x:Name="HandleBr" Width="12" Height="12" Fill="White" Stroke="Black" IsHitTestVisible="False" />
            </Canvas>
        </Grid>
    </DockPanel>
</UserControl>
